erDiagram
  ORGANIZATION {
    uuid id PK
    string name
    string bic
    uuid api_key_id
    uuid created_by  "user_id (optional)"
    datetime created_at
    datetime updated_at
  }

  "USER" {
    uuid id PK
    uuid org_id FK   "belongs to ORGANIZATION (tenant)"
    string email
    string username
    string role_id   "Keycloak role name"
    boolean is_active
    uuid created_by  "user_id (optional)"
    datetime created_at
    datetime updated_at
  }

  WALLET_ALLOW_LIST {
    uuid id PK
    uuid user_id FK   "owner (extends USER)"
    string address
    string label
    string network
    boolean is_active
    datetime created_at
  }

  CONTRACT_ALLOW_LIST {
    uuid id PK
    uuid user_id FK   "owner (extends USER)"
    string address
    string label
    string chain_id
    boolean is_active
    datetime created_at
  }

  TRANSACTION {
    uuid id PK
    uuid org_id FK     "scoped to ORGANIZATION"
    uuid created_by FK "user_id"
    string payload     "JSON as text"
    string status      "confirmed|failed"
    datetime created_at
  }

  %% --------- Relationships ----------
  ORGANIZATION ||--o{ "USER" : has
  "USER" ||--o{ WALLET_ALLOW_LIST : owns_wallets
  "USER" ||--o{ CONTRACT_ALLOW_LIST : owns_contracts

  ORGANIZATION ||--o{ TRANSACTION : has_many
  "USER" ||--o{ TRANSACTION : created_by