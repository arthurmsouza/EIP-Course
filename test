erDiagram
    ORGANIZATION ||--o{ USER : "has many"
    ORGANIZATION ||--o{ PERMISSION_ALLOWLIST : "defines"
    ORGANIZATION ||--o{ TRANSACTION : "owns"

    USER ||--o{ TRANSACTION : "created_by"

    ORGANIZATION {
      uuid id PK  "tenant_id"
      string name
      string bic          
      datetime created_at
      datetime updated_at
    }

    USER {
      uuid id PK
      uuid org_id         "-> ORGANIZATION.id"
      string email
      string role_id      "Keycloak role id or name"
      boolean is_active
      datetime created_at
      datetime updated_at
    }

    PERMISSION_ALLOWLIST {
      uuid id PK
      uuid org_id         "-> ORGANIZATION.id"
      string wallet_address
      string label
      boolean active
      datetime created_at
    }

    TRANSACTION {
      uuid id PK
      uuid org_id         "-> ORGANIZATION.id"
      uuid created_by     "-> USER.id"
      string to_wallet
      decimal amount
      string payload      "JSON as text"
      string status       "draft|submitted|confirmed|failed"
      datetime created_at
    }